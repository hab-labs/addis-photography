# ==============================================================================
# Addis Photography Studio Management System - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate.
# NEVER commit your real .env file or production credentials to version control.
# ==============================================================================

# Database Connection (PostgreSQL 14+)
# If left empty, the application falls back to the built-in ACID in-memory engine.
DATABASE_URL=postgresql://addis:addis_secure_2026@localhost:5432/addis_photography

# Session & Security
# Cryptographically random 32+ character key used to sign sessions and cookies.
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars_long

# Persistent Media Storage Paths
STORAGE_PATH=./data/media
CHUNKS_PATH=./data/chunks

# Studio Official Timezone
TZ=Africa/Addis_Ababa

# Port Configuration
PORT=3000
